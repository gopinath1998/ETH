create or replace transient table DBT.DBT_NLM_marts.token_activity_per_day
    

    
    as (

select

    t.date,
    t.token_address,
    

(sum( t.value /POWER(10, 6) ))

 as total_usd_value

from DBT.DBT_NLM.stg_token_transfers t
